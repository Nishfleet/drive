# The Node version is a requirement, not a suggestion (drive#432).
#
# `engines.node` in package.json is ">=24" and .nvmrc pins the line to 24. npm
# only *warns* about an unsupported engine by default, which a new contributor
# scrolls past; this makes it a hard stop instead, so `npm ci` on an older Node
# fails with the version it found and the version the repo needs.
#
# node:sqlite (test/harness.mjs, test/d1-sqlite.mjs) is experimental before
# Node 24, so an older Node is not merely unsupported: it changes what the
# tests exercise. `npm run node:check` prints the same message for the
# run-time commands (dev, check, build, test).
engine-strict=true
