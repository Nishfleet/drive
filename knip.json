{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.js",
    "workers/api/src/index.js",
    "workers/dl/src/index.js",
    "test/*.test.mjs",
    "test/integration/*.test.mjs",
    "test/walks/*.test.mjs",
    "workers/*/test/*.test.js"
  ],
  "project": ["core/**/*.js", "src/**/*.js", "workers/**/*.js"],
  "ignoreBinaries": ["unshare", "ffmpeg", "ffprobe", "mount", "findmnt"],
  "ignoreDependencies": ["@stryker-mutator/command-runner", "axe-core", "rolldown", "zod"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "exports": "error",
    "types": "off",
    "duplicates": "off"
  }
}
