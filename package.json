{
  "name": "drive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "drive: a Finder drive for people and their agents. This Worker serves the pricing and landing page and stores waitlist sign-ups in D1 (drive issue #11).",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "pretypecheck": "cf workers types",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "pretest": "npm run check",
    "docs:render": "node src/render-docs.js",
    "docs:build": "npm run docs:render && vitepress build docs-site",
    "test": "npm run docs:build && node --test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "cf": "^1.0.0-beta.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.14.0"
  }
}
