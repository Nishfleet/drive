{
  "ci": {
    "collect": {
      "staticDistDir": "./.cloudflare/output/v0/workers/default/assets",
      "url": [
        "http://localhost/index.html",
        "http://localhost/signin.html",
        "http://localhost/home.html",
        "http://localhost/files.html",
        "http://localhost/usage.html",
        "http://localhost/devices.html",
        "http://localhost/webhooks.html",
        "http://localhost/upload.html",
        "http://localhost/get-started.html",
        "http://localhost/terms.html",
        "http://localhost/privacy.html",
        "http://localhost/refunds.html",
        "http://localhost/acceptable-use.html",
        "http://localhost/support.html",
        "http://localhost/accessibility.html",
        "http://localhost/status.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "throttling": {
          "rttMs": 40,
          "throughputKbps": 10240,
          "cpuSlowdownMultiplier": 1
        }
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 1500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.01
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 150
              }
            ],
            "resource-summary.script:count": [
              "error",
              {
                "maxNumericValue": 1
              }
            ],
            "resource-summary.stylesheet:count": [
              "error",
              {
                "maxNumericValue": 1
              }
            ],
            "resource-summary.third-party:count": [
              "error",
              {
                "maxNumericValue": 1
              }
            ],
            "resource-summary.third-party:transferSize": [
              "error",
              {
                "maxNumericValue": 0
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "total-byte-weight": [
              "error",
              {
                "maxNumericValue": 307200
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "http://localhost/index\\.html$",
          "assertions": {
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ]
          }
        }
      ]
    }
  }
}
