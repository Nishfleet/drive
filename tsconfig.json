{
	"compilerOptions": {
		"target": "es2024",
		// The Workers runtime is the target, so `dom` covers the fetch platform
		// globals the Worker code shares with a browser (Request, Response,
		// URL, crypto, console) and `.cloudflare/types/index.d.ts` — the file
		// `cf workers types` generates from cloudflare.config.ts and the
		// toolchain's own workerd build — supplies the Workers-only ones
		// (D1Database, RateLimitBinding, URLPattern, the bound Env). That is
		// the runtime type set this issue asks for; there is no hand-rolled
		// copy of either to drift.
		"lib": ["es2024", "dom"],
		"module": "preserve",
		"moduleResolution": "bundler",
		// The runtime types are ambient globals pulled in by the include list
		// below, not an @types package, so no `types` are auto-loaded.
		"types": [],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"allowJs": true,
		// drive issue #91: the repo is JSDoc-typed JavaScript, so this is the
		// switch that makes those annotations load-bearing instead of comments.
		"checkJs": true,
		// `types: []` keeps the Workers runtime types to the generated
		// `.cloudflare/types/index.d.ts` only (see include below) and the
		// `dom`/`es2024` libs, never an @types package — node-typed build
		// scripts (src/render-docs.js) and the node:test trees live in their
		// own check scope (tsconfig.test.json, drive issue #91 remainder).
		"types": []
	},
	"include": [
		"src",
		"cloudflare.config.ts",
		".cloudflare/types/index.d.ts"
	],
	"exclude": [
		// Node build-time script and the docs site: they import node:fs and use
		// `process`, which need @types/node; that is drive issue #91's type-test
		// remainder, not the Worker's check scope here.
		"src/render-docs.js",
		"docs-site",
		"test"
	]
}
