{
  "ci": {
    "collect": {
      "staticDistDir": "./.cloudflare/output/v0/workers/default/assets",
      "url": [
        "http://localhost/index.html",
        "http://localhost/signin.html",
        "http://localhost/files.html",
        "http://localhost/usage.html",
        "http://localhost/upload.html",
        "http://localhost/get-started.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "throttling": {
          "rttMs": 40,
          "throughputKbps": 10240,
          "cpuSlowdownMultiplier": 1
        }
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.01 }],
        "total-blocking-time": ["error", { "maxNumericValue": 300 }],
        "resource-summary.script:count": ["error", { "maxNumericValue": 1 }],
        "resource-summary.stylesheet:count": ["error", { "maxNumericValue": 1 }],
        "resource-summary.third-party:count": ["error", { "maxNumericValue": 1 }],
        "resource-summary.third-party:transferSize": ["error", { "maxNumericValue": 0 }]
      }
    }
  }
}
