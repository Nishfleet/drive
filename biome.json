{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!public/docs",
      "!docs-site/.rendered",
      "!.cloudflare",
      "!node_modules",
      "!.lighthouseci",
      "!marketing/launch-video/assets/gsap-3.14.2.min.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["public/files.html", "public/index.html", "public/upload.html"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**/*.js"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/workers/**"],
                    "importNamePattern": ".*",
                    "message": "a module in src/ must not import a Worker directory. Move what is shared into core/ and import it from there (drive#616)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["core/**/*.js"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/workers/**"],
                    "importNamePattern": ".*",
                    "message": "a module in core/ must not import a Worker directory. Move what is shared into core/ and import it from there (drive#616)."
                  },
                  {
                    "group": ["**/src/**"],
                    "importNamePattern": ".*",
                    "message": "a module in core/ must not import the site Worker's src/. core/ is shared by both Workers, so it imports only core/ (drive#616)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["workers/*/src/**/*.js"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/src/**"],
                    "importNamePattern": ".*",
                    "message": "a Worker must not import the site Worker's src/. Move what is shared into core/ and import it from there (drive#616)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
